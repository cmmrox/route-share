# RouteShare PRODUCTION environment template
# Load from a secret manager (Doppler / AWS Secrets Manager / Vault). NEVER commit the filled file.
# Every value below is mandatory before public release unless explicitly noted.

# --- Core platform ---
SPRING_PROFILES_ACTIVE=json
ROUTESHARE_JDBC_URL=jdbc:postgresql://<prod-db-host>:5432/routeshare
ROUTESHARE_DB_USER=routeshare_app          # least-privilege app role, not a superuser
ROUTESHARE_DB_PASSWORD=<prod-db-password>
ROUTESHARE_DB_POOL_MAX_SIZE=40
ROUTESHARE_DB_POOL_MIN_IDLE=10
ROUTESHARE_REDIS_HOST=<prod-redis-host>
ROUTESHARE_REDIS_PORT=6379
ROUTESHARE_KEYCLOAK_ISSUER=https://auth.routeshare.lk/realms/routeshare
ROUTESHARE_KEYCLOAK_SERVER_URL=https://auth.routeshare.lk
ROUTESHARE_KEYCLOAK_ADMIN_USERNAME=<keycloak-admin>
ROUTESHARE_KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>

# --- Event streaming ---
ROUTESHARE_EVENTS_KAFKA_ENABLED=true
ROUTESHARE_KAFKA_BOOTSTRAP_SERVERS=<prod-redpanda>:9092
ROUTESHARE_EVENTS_TOPIC_PREFIX=routeshare.

# --- SMS/OTP — Notify.lk (approved production sender) ---
NOTIFY_LK_ENABLED=true
NOTIFY_LK_API_BASE_URL=https://app.notify.lk/api/v1
NOTIFY_LK_API_USER_ID=<notify-user-id>
NOTIFY_LK_API_KEY=<notify-api-key>
NOTIFY_LK_SENDER_ID=<approved-production-sender-id>
NOTIFY_LK_ALLOW_DEMO_SENDER_FOR_OTP=false   # MUST stay false in production

# --- Maps — Google Maps Platform (server key restricted by IP) ---
GOOGLE_MAPS_ENABLED=true
GOOGLE_MAPS_SERVER_API_KEY=<server-key-ip-restricted>

# --- Payments — Cybersource (live) ---
CYBERSOURCE_ENABLED=true
CYBERSOURCE_ENVIRONMENT=production
CYBERSOURCE_MERCHANT_ID=<merchant-id>
CYBERSOURCE_KEY_ID=<key-id>
CYBERSOURCE_SHARED_SECRET=<shared-secret>
CYBERSOURCE_CAPTURE_MODE=manual             # capture final fare after trip completion
CYBERSOURCE_WEBHOOK_SECRET=<webhook-secret>

# --- Object storage (S3/R2, private bucket, server-side encryption) ---
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=https://<s3-endpoint>
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_BUCKET=routeshare-documents
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>
OBJECT_STORAGE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=900

# --- Push — Firebase Cloud Messaging ---
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/firebase-service-account.json

# --- Observability — Sentry ---
SENTRY_DSN_BACKEND=<backend-dsn>
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=routeshare-api@<release-version>
SENTRY_TRACES_SAMPLE_RATE=0.1
