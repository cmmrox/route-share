{
  "name": "@routeshare/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start --dev-client",
    "start:android:local": "expo start --dev-client --port 8082 --host lan",
    "start:android:local:clear": "expo start --dev-client --port 8082 --host lan --clear",
    "start:web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:e2e:ios": "node scripts/e2e-smoke.mjs ios",
    "test:e2e:android": "node scripts/e2e-smoke.mjs android",
    "prebuild": "expo prebuild --clean",
    "build:preview:ios": "node scripts/preview-build-check.mjs ios",
    "build:preview:android": "node scripts/preview-build-check.mjs android",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "^56.0.15",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "@routeshare/api-contracts": "workspace:*",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "^56.0.11",
    "expo-auth-session": "^56.0.14",
    "expo-constants": "^56.0.18",
    "expo-font": "~56.0.7",
    "expo-image": "^56.0.11",
    "expo-image-picker": "^56.0.17",
    "expo-linking": "^56.0.14",
    "expo-location": "^56.0.17",
    "expo-notifications": "^56.0.17",
    "expo-secure-store": "^56.0.4",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "^56.0.4",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.79.0",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-maps": "^1.27.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.18.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "detox": "^20.51.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "expect": "29.7.0",
    "expo-doctor": "^1.19.10",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "prettier": "^3.8.4",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15"
  },
  "main": "index.ts"
}
