{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@api/*": [
        "src/api/*"
      ],
      "@app/*": [
        "src/app/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ]
    },
    "types": [
      "vitest/globals",
      "node"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "App.tsx",
    "index.ts",
    "app.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts"
  ]
}
