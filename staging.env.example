# RouteShare STAGING environment template
# Copy to a deployment secret store (never commit the filled-in file).
# Staging mirrors production wiring but uses sandbox/test provider credentials.

# --- Core platform ---
SPRING_PROFILES_ACTIVE=json
ROUTESHARE_JDBC_URL=jdbc:postgresql://<staging-db-host>:5432/routeshare
ROUTESHARE_DB_USER=routeshare_app
ROUTESHARE_DB_PASSWORD=<staging-db-password>
ROUTESHARE_DB_POOL_MAX_SIZE=20
ROUTESHARE_REDIS_HOST=<staging-redis-host>
ROUTESHARE_REDIS_PORT=6379
ROUTESHARE_KEYCLOAK_ISSUER=https://auth.staging.routeshare.lk/realms/routeshare
ROUTESHARE_KEYCLOAK_SERVER_URL=https://auth.staging.routeshare.lk
ROUTESHARE_KEYCLOAK_ADMIN_USERNAME=<keycloak-admin>
ROUTESHARE_KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>

# --- Event streaming (real broker in staging) ---
ROUTESHARE_EVENTS_KAFKA_ENABLED=true
ROUTESHARE_KAFKA_BOOTSTRAP_SERVERS=<staging-redpanda>:9092
ROUTESHARE_EVENTS_TOPIC_PREFIX=routeshare.staging.

# --- SMS/OTP — Notify.lk (real sender, staging numbers) ---
NOTIFY_LK_ENABLED=true
NOTIFY_LK_API_BASE_URL=https://app.notify.lk/api/v1
NOTIFY_LK_API_USER_ID=<notify-user-id>
NOTIFY_LK_API_KEY=<notify-api-key>
NOTIFY_LK_SENDER_ID=<approved-sender-id>
NOTIFY_LK_ALLOW_DEMO_SENDER_FOR_OTP=false

# --- Maps — Google Maps Platform ---
GOOGLE_MAPS_ENABLED=true
GOOGLE_MAPS_SERVER_API_KEY=<server-key-ip-restricted>

# --- Payments — Cybersource (sandbox/apitest) ---
CYBERSOURCE_ENABLED=true
CYBERSOURCE_ENVIRONMENT=sandbox
CYBERSOURCE_MERCHANT_ID=<merchant-id>
CYBERSOURCE_KEY_ID=<key-id>
CYBERSOURCE_SHARED_SECRET=<shared-secret>
CYBERSOURCE_CAPTURE_MODE=manual
CYBERSOURCE_WEBHOOK_SECRET=<webhook-secret>

# --- Object storage (S3/R2) ---
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=https://<s3-endpoint>
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_BUCKET=routeshare-staging-documents
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>
OBJECT_STORAGE_PATH_STYLE=false

# --- Push — Firebase Cloud Messaging ---
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/firebase-service-account.json

# --- Observability — Sentry ---
SENTRY_DSN_BACKEND=<backend-dsn>
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.3
