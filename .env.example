# RouteShare local development environment template
# Copy to `.env` for local development. Keep real secrets only in `.env` or a secret manager.

# PostgreSQL/PostGIS local database
ROUTESHARE_POSTGRES_DB=routeshare
ROUTESHARE_POSTGRES_USER=routeshare
ROUTESHARE_POSTGRES_PASSWORD=change-me-local-only
ROUTESHARE_POSTGRES_PORT=5433
ROUTESHARE_JDBC_URL=jdbc:postgresql://localhost:5433/routeshare

# Local infrastructure admin users
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only

# SMS/OTP — Notify.lk
NOTIFY_LK_ENABLED=false
NOTIFY_LK_API_BASE_URL=
NOTIFY_LK_API_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=
# Local/backend-only QA can set this to true to allow NotifyDEMO and accept 000000.
# Keep false for production and committed defaults.
NOTIFY_LK_ALLOW_DEMO_SENDER_FOR_OTP=false
NOTIFY_LK_OTP_MESSAGE_TEMPLATE=Your RouteShare verification code is %s. It expires in %d minutes.
NOTIFY_LK_OTP_TEMPLATE_ID=

# Maps — Google Maps Platform
# Required for production-real Task 07 Home Map/Search Places and later Task 08/11 map flows.
# Do not mark those stages complete with fake maps or placeholder geocoding when these are missing.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Payments — Cybersource
CYBERSOURCE_ENABLED=false
CYBERSOURCE_ENVIRONMENT=sandbox
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SHARED_SECRET=
CYBERSOURCE_CAPTURE_MODE=manual
CYBERSOURCE_WEBHOOK_SECRET=

# Push notifications — Firebase Cloud Messaging
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
# Backend FCM delivery: path to the Firebase service-account JSON (server secret).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Mobile client config files.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# Object storage — KYC/vehicle/profile documents (MinIO local; S3/R2 in prod)
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=routeshare-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=change-me-local-only
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=900

# Event streaming — Kafka/Redpanda outbox relay
ROUTESHARE_EVENTS_KAFKA_ENABLED=false
ROUTESHARE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ROUTESHARE_EVENTS_TOPIC_PREFIX=routeshare.

# Observability — Sentry
SENTRY_DSN_PASSENGER=
SENTRY_DSN_DRIVER=
SENTRY_DSN_ADMIN=
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
